# mkxp-rs sample configuration file (RON format).
# Copy this file to your game directory to use it.
# User-level overrides go in ~/.config/mkxp-rs/mkxp.ron.
#
# Merge priority: env vars > CLI args > user config > game-dir config > defaults

(
    ruby: (
        # RGSS version: "1" = XP, "2" = VX, "3" = VX Ace
        rgss_version: "3",
        # Ruby scripts loaded before game execution begins
        preload_scripts: [],
        # Scripts loaded just before rgss_main (RGSS3 only)
        postload_scripts: [],
        # Single-script mode — runs this file instead of the full game
        custom_script: None,
        # Command-line arguments forwarded to Ruby scripts as ARGV
        launch_args: [],        # Forwarded to Ruby ARGV
        use_script_names: true,
    ),

    window: (
        # Window title. Empty string uses the Game.ini Title field.
        title: "",
        # Initial window size.
        size: (640, 480),
        # Start in fullscreen mode. Can still be toggled with Alt+Enter at runtime.
        fullscreen: false,
        # Allow the user to resize the window by dragging its edges
        resizable: true,
        # Preserve the game screen's aspect ratio on resize (letterboxing)
        fixed_aspect_ratio: true,
        # Parsed for compatibility; runtime integer-scale commands are in the View menu.
        integer_scaling: false,
        # Parsed for compatibility; frame skipping is not wired into the render host yet.
        frame_skip: false,
    ),

    graphics: (
        # Vertical synchronisation (prevents screen tearing)
        vsync: true,
        # Parsed for compatibility; refresh-rate timing is not wired into the render host yet.
        sync_to_refresh_rate: false,
        # Frame rate cap. 0 disables the render-host FPS gate.
        frame_rate: 60,
        # Logical resolution (Graphics.width / Graphics.height).
        # Non-positive values fall back to the reference default.
        game_size: (640, 480),

        # ---- Scaling ----
        # Primary scaling algorithm, applied to screen upscale, downscale, and bitmap scaling.
        # One of: "nearest" | "bilinear" | "bicubic" | "lanczos3" | "xbrz"
        scale_mode: "bilinear",
        # Override the screen-upscale algorithm (None = inherit from scale_mode)
        scale_up: None,
        # Override the screen-downscale algorithm
        scale_down: None,
        # Override the bitmap-upscale algorithm
        bitmap_scale_up: None,
        # Override the bitmap-downscale algorithm
        bitmap_scale_down: None,
        # Enable mipmap interpolation when downscaling with bilinear
        mipmaps: false,
        # Bicubic sharpness (0-200, default 100)
        bicubic_sharpness: 100,
        # xBRZ scaling factor
        xbrz_factor: 4.0,

        # High-resolution texture replacement.
        # When enabled, the engine looks for higher-resolution versions of game
        # bitmaps in the "Hires" subdirectory.
        hires: (
            enabled: false,
            # Scale factor of the hi-res textures relative to the originals
            factor: 4.0,
        ),
        # Hardware framebuffer blitting.
        # Forcibly disabled when using non-nearest/non-bilinear scaling.
        enable_blitting: true,
        # Maximum texture size (0 = hardware limit). Useful for low-spec machines.
        max_texture_size: 0,
        # Snap rendering to integer pixels.
        # When disabled, sprites get sub-pixel precision for smoother movement.
        # (New in mkxp-rs; mkxp-z has no equivalent.)
        pixel_snap: false,
    ),

    paths: (
        # Game root directory (None = current working directory)
        game_folder: None,
        # RPG Maker RTP archive paths (directories, .zip files, encrypted archives)
        rtp: [],
        # Patch / mod search paths, searched before the game directory
        patches: [],
        # Window icon path (Linux only, None = use built-in default icon)
        icon_path: None,
    ),

    fonts: (
        # Default font family used when the script requests a non-existing font
        default_family: "Arial",
        # Global font size multiplier (1.0 = original size)
        scale: 1.0,
        # Font hinting level: "normal" | "light" | "mono" | "none"
        # RGSS does not use hinting; "none" gives the most accurate appearance.
        hinting: "none",
        # Character kerning adjustment. RGSS does not use kerning.
        kerning: false,
        # Crop the top row and left column of text with outlines (RGSS behaviour)
        outline_crop: true,
        # Font family substitution rules: [{ from: "requested font", to: "actual font" }, ...]
        substitutions: [],
        # "Solid" font families rendered without alpha blending (cached for performance)
        solid: [],
        # Text height calculation mode:
        #   "nominal"  = RGSS behaviour (may clip glyph descenders)
        #   "rendered" = actual rendered height (may look better)
        height_reporting: "nominal",
    ),

    input: (
        # Keyboard bindings: [{ key: "key-name", action: "action-name" }, ...]
        # Key names: "A"-"Z", "0"-"9", "F1"-"F12",
        #            "Up" "Down" "Left" "Right",
        #            "Space" "Enter" "Escape" "Tab" "Backspace",
        #            "LShift" "RShift" "LCtrl" "RCtrl" "LAlt" "RAlt"
        # Action names: "confirm" "cancel" "menu" "run" "walk_slow"
        #               "a" "b" "c" "x" "y" "z" "l" "r"
        #               "direction_up" "direction_down" "direction_left" "direction_right"
        key_bindings: [],
        # Gamepad bindings (same format as keyboard)
        gamepad_bindings: [],
        # Display names shown in the F1 key-config menu: { "action": "display name" }
        binding_names: {},
        # Allow F12 to reset the game
        enable_reset: true,
        # Allow F1 to open the key-binding settings menu
        enable_settings: true,
    ),

    audio: (
        # Master volume (0.0-1.0)
        master_volume: 1.0,
        bgm_volume: 1.0,
        se_volume: 1.0,
        bgs_volume: 1.0,
        me_volume: 1.0,
        # SoundFont path for MIDI playback (rustysynth).
        # When empty, MIDI plays silently without crashing.
        midi_soundfont: None,
        # MIDI chorus / reverb effects
        midi_chorus: false,
        midi_reverb: false,
        # Maximum simultaneous SE sources (max 64)
        se_source_count: 6,
        # Maximum simultaneous BGM tracks (max 16)
        bgm_track_count: 1,
    ),

    debug: (
        # Enable debug logging (prints engine internals to stdout)
        mode: false,
        # Launch a standalone console window (Windows only)
        console: false,
        # FPS display mode: "none" | "titlebar" | "console" | "both"
        show_fps: "none",
        # Log verbosity override: "error" | "warn" | "info" | "debug" | "trace".
        # When set, takes precedence over `mode`.  None = use `mode` as shortcut.
        log_level: None,
    ),
)
